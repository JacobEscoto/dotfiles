#container {
  background-color: #11111B;
  font-family: "Rubik", "Sans Serif", sans-serif;
  border: 1px solid #36363d;
  border-radius: 16px;
}

#monthYearLabel {
  color: #CDD6F4;
  font-family: "Rubik", "Sans Serif", sans-serif;
  font-size: 16px;
  font-weight: 600;
  background: transparent;
}

#prevButton {
  padding: 5px;
  color: #CDD6F4;
  font-size: 15pt;
  background: transparent;
  border: none;
}

#nextButton {
  padding: 5px;
  color: #CDD6F4;
  font-size: 15pt;
  background: transparent;
  border: none;
}

#divider {
  background-color: #585B70;
  max-height: 1px;
  border: none;
}

#bottomPanel {
  background: transparent;
}

QLabel[header="true"] {
  color: #CDD6C9;
  font-size: 9pt;
  font-weight: 600;
  background: transparent;
}

QLabel#dayCell {
  color: #CDD6F4;
  font-size: 10pt;
  background: transparent;
  border-radius: 6px;
  padding: 2px;
}

QLabel#dayCell[today="true"] {
  background-color: #89DCEB;
  color: #11111B;
  font-weight: 700;
  border-radius: 12px;
  border: none;
}
