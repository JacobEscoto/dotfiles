@import "colors.rasi"

configuration {
  font:                 "FiraCode 10";
  show-icons:           false;
  display-drun:         "";
  drun-display-format:  "{name}";
  disable-history:      false;
  fullscreen:           false;
  hide-scrollbar:       true;
  sidebar-mode:         false;
}

window {
  transparency:     "real";
  background-color: @bg;
  text-color:       @fg;
  border:           1px;
  border-color:     @ac;
  border-radius:    6px;
  width:            480px;
  location:         center;
  x-offset:         0;
  y-offset:         0;
}

prompt {
  enabled:          true;
  padding:          0px 0px 0px 0px;
  background-color: @bg;
  text-color:       @fg;
  expand:           true;
  str:              "";
  font:             "FiraCode 10";
}

inputbar {
  children:         [ prompt ];
  background-color: @bg;
  text-color:       @fg;
  expand:           false;
  border:           0px 0px 1px 0px;
  border-radius:    0px;
  border-color:     @se;
  margin:           0px;
  padding:          10px;
  horizontal-align: 0.5;
}

listview {
  background-color: @al;
  padding:          10px;
  columns:          5;
  lines:            1;
  spacing:          10px;
  cycle:            true;
  dynamic:          true;
  fixed-columns:    true;
}

mainbox {
  background-color: @al;
  border:           0px;
  border-radius:    0px;
  border-color:     @ac;
  children:         [ inputbar, listview ];
  spacing:          5px;
  padding:          5px;
}

element {
  background-color: @bga;
  text-color:       @fg;
  orientation:      vertical;
  border-radius:    8px;
  padding:          14px 4px 14px 4px;
}

element-icon {
  size: 0px;
}

element-text {
  background-color: transparent;
  text-color:        inherit;
  expand:            true;
  horizontal-align:  0.5;
  vertical-align:    0.5;
  font:              "FiraCode 14";
}

element selected {
  background-color: @ac;
  text-color:       @bg;
  border:           0px;
  border-radius:    8px;
  border-color:     @ac;
}
