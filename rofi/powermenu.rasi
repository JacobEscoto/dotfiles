@import "colors.rasi"

configuration {
  font:                "Rubik 11";
  show-icons:          false;
  hide-scrollbar:      true;
  sidebar-mode:        false;
}

* {
  background-color:    transparent;
  text-color:          @fg;
  font:                "Rubik 11";
}

window {
  transparency:        "real";
  location:            center;
  anchor:              center;
  fullscreen:          true;
  background-color:    #11111BD9;
  padding:             0px;
}

mainbox {
  orientation:         vertical;
  children:            [ dummy-top, message, listview, dummy-bottom ];
  spacing:             28px;
  padding:             0px 28%;
  background-color:    transparent;
}

dummy-top, dummy-bottom { expand: true; background-color: transparent; }

message {
  expand:              false;
  background-color:    @se;
  border:              1px;
  border-color:        @muted;
  border-radius:       999px;
  padding:             12px 26px;
  text-color:          @fg;
  font:                "Rubik Medium 14";
}

listview {
  expand:              false;
  columns:             5;
  lines:               1;
  spacing:             20px;
  layout:              vertical;
  fixed-columns:       true;
  fixed-height:        true;
  dynamic:             false;
  cycle:               true;
  scrollbar:           false;
  background-color:    transparent;
}

element {
  orientation:         vertical;
  background-color:    @se;
  border:              1px;
  border-color:        @muted;
  border-radius:       999px;
  padding:             30px 0px;
}

element-text {
  expand:              true;
  background-color:    transparent;
  text-color:          inherit;
  font:                "feather 16";
  horizontal-align:    0.5;
  vertical-align:      0.5;
  padding:             0px;
  margin:              0px;
}

element selected {
  background-color:    @muted;
  text-color:          @lightblue;
  border-color:        @lightblue;
}
