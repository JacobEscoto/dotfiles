@import "colors.rasi"

configuration {
  font:                 "JetBrains Mono 10";
  show-icons:           false;
  disable-history:      false;
  fullscreen:           false;
  hide-scrollbar:       true;
  sidebar-mode:         false;
}

window {
  transparency:     "real";
  background-color: @bg;
  text-color:       @fg;
  border:           2px;
  border-color:     @muted;
  border-radius:    12px;
  width:            420px;
  location:         northeast;
  anchor:           northeast;
  x-offset:         -30px;
  y-offset:         45px;
}

prompt {
  enabled:          true;
  padding:          0px 0px 0px 0px;
  background-color: @bg;
  text-color:       @fg;
  expand:           true;
  str:              "";
  font:             "JetBrains Mono 10";
}

inputbar {
  children:         [ prompt, entry ];
  background-color: @bg;
  text-color:       @fg;
  expand:           false;
  border:           0px 0px 1px 0px;
  border-radius:    0px;
  border-color:     @se;
  margin:           0px;
  padding:          10px;
}

entry {
  background-color: @bg;
  text-color:       @fg;
  placeholder:       "Search Network...";
  placeholder-color: @muted;
  expand:            true;
  horizontal-align:  0;
}

listview {
  background-color: @bg;
  padding:          0px;
  columns:          1;
  lines:            8;
  spacing:          0px;
  cycle:            true;
  dynamic:          true;
  fixed-columns:    true;
}

mainbox {
  background-color: @bg;
  border:           0px;
  border-radius:    0px;
  children:         [ inputbar, listview ];
  spacing:          5px;
  padding:          0px;
}

element {
  background-color: @bg;
  text-color:       @fg;
  orientation:      horizontal;
  border-radius:    0px;
  padding:          10px 12px 10px 12px;
}

element-icon {
  size: 0px;
}

element-text {
  background-color: transparent;
  text-color:        inherit;
  expand:            true;
  horizontal-align:  0;
  vertical-align:    0.5;
  font:              "FiraCode 11";
}

element selected {
  background-color: @se;
  text-color:       @lightblue;
  border:           0px;
  border-radius:    0px;
}

error-message {
  background-color: @bg;
  text-color:       @red;
  border:           0px;
  border-radius:    0px;
  padding:          10px;
}
