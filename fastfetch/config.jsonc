{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/dragon.txt",
    "width": 48,
    "height": 24,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 2,
      "bottom": 2
    },
    "color": {
      "1": "38;2;92;193;209"
    }
  },
  "display": {
    "separator": " │ "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{#38;2;92;193;209}╭─ 󰌢  System ─────────────────────────────╮{#}"
    },
    {
      "type": "title",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235} User{#}    ",
      "format": "{user-name}"
    },
    {
      "type": "host",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰌢 Host{#}    ",
      "format": "{name}"
    },
    {
      "type": "os",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235} OS{#}      ",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰒋 Kernel{#}  ",
      "format": "{sysname} {release}"
    },
    {
      "type": "uptime",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󱎫 Uptime{#}  ",
      "format": "{days}d {hours}h {minutes}m"
    },
    {
      "type": "custom",
      "format": "{#38;2;92;193;209}├─ 󰍹  Desktop ────────────────────────────┤{#}"
    },
    {
      "type": "wm",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235} WM{#}      "
    },
    {
      "type": "terminal",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235} Terminal{#}"
    },
    {
      "type": "shell",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰞷 Shell{#}   "
    },
    {
      "type": "terminalfont",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰛖 Font{#}    "
    },
    {
      "type": "icons",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰀻 Icons{#}   "
    },
    {
      "type": "custom",
      "format": "{#38;2;92;193;209}├─ 󰍛  Hardware ───────────────────────────┤{#}"
    },
    {
      "type": "cpu",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰍛 CPU{#}     ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰢮 GPU{#}     ",
      "format": "{name}"
    },
    {
      "type": "display",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰍹 Display{#} ",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "memory",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰘚 RAM{#}     ",
      "format": "{used} / {total}"
    },
    {
      "type": "swap",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰓡 Swap{#}    ",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "{#38;2;92;193;209}│{#} {#38;2;160;225;235}󰋊 Disk{#}    ",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "custom",
      "format": "{#38;2;92;193;209}╰─────────────────────────────────────────╯{#}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
