# ========================================================
#  SETTINGS
# ========================================================
set $mod Mod4
set $terminal kitty
set $file_manager dolphin
set $browser flatpak run app.zen_browser.zen

# Font for window titles
font pango:Fira Code 8

default_border pixel 0
default_floating_border pixel 1
hide_edge_borders both

workspace_layout tabbed
workspace_auto_back_and_forth yes
focus_follows_mouse no
mouse_warping output
popup_during_fullscreen smart

# Gaps
gaps inner 0
gaps outer 2
gaps top 30
smart_gaps off

# Scratchpad
set $scratch_term kitty --class scratch_term
bindsym $mod+grave exec --no-startup-id $scratch_term
for_window [class="scratch_term"] floating enable, move scratchpad, resize set 800 500, border pixel 0
bindsym $mod+Shift+grave scratchpad show

# ========================================================
#  STARTUP
# ========================================================

# Enable touchpad tapping
exec --no-startup-id xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Tapping Enabled" 1

# Environment variable for dolphin
exec --no-startup-id export XDG_MENU_PREFIX=plasma-

# Run commands for desktop personalization (Workspaces, polybar, wallpaper and picom).
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id feh --bg-scale ~/Pictures/forest-wallpaper.jpg
exec_always --no-startup-id picom -b
exec_always --no-startup-id dunst

# Start flameshot in the background
exec --no-startup-id flameshot

# Toggle keyboard language
exec --no-startup-id bash -c "sleep 2 && setxkbmap -layout 'us,latam' -option 'grp:alt_shift_toggle'"

# ========================================================
#  KEYBINDINGS
# ========================================================

# Volume
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/osd-volume.sh -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/osd-volume.sh -d 5
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/scripts/osd-volume.sh -t

# Multimedia playback controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# App launcher
bindsym $mod+space exec --no-startup-id ~/.config/rofi/scripts/launcher.sh

# File manager
bindsym $mod+e exec --no-startup-id $file_manager

# Task manager
bindsym Control+Shift+Escape exec --no-startup-id kitty -- btop

# Terminal
bindsym $mod+Return exec $terminal
bindsym $mod+Shift+t exec $terminal

# Kill window
bindsym $mod+Shift+q kill

# Show emoji menu
bindsym $mod+period exec rofi -show emoji -modi emoji -theme ~/.config/rofi/emoji.rasi -emoji-format "{emoji}" -p "󰞅"

# Change layout mode
bindsym $mod+w layout tabbed
bindsym $mod+y layout stacking
bindsym $mod+u layout toggle split

# Web browser
bindsym $mod+Shift+w exec $browser

# Floating modifier
floating_modifier $mod

# Floating toggle
bindsym $mod+Shift+space floating toggle

# Change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Change focus (arrow keys as alternative)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Move windows (arrow keys as alternative)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split horizontal and vertical
bindsym $mod+minus split h
bindsym $mod+backslash split v

# Fullscreen mode
bindsym $mod+f fullscreen toggle

# Reload configuration
bindsym $mod+Shift+c reload

# Restart i3
bindsym $mod+Shift+r restart

# Lock screen
bindsym $mod+Escape exec --no-startup-id ~/.config/i3/scripts/lock.sh

# Take screenshot with flameshot
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym $mod+Shift+Print exec --no-startup-id flameshot gui -d 3000

# ========================================================
#  WORKSPACES
# ========================================================
set $ws1 "1:web"
set $ws2 "2:terminal"
set $ws3 "3:docs"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

# Move window to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9; workspace number $ws9

# Cycle workspaces
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

# Resize mode
bindsym $mod+r mode "resize"

mode "resize" {
  bindsym h resize shrink width 5 px or 5 ppt
  bindsym j resize grow height 5 px or 5 ppt
  bindsym k resize shrink height 5 px or 5 ppt
  bindsym l resize grow width 5 px or 5 ppt
  bindsym Escape mode "default"
}

# ========================================================
#  FLOATING RULE FOR SELECTED WINDOWS/APPS
# ========================================================

# Zoom meeting and tools
for_window [class="^zoom$"] floating enable
for_window [class="^zoom$" title="Zoom Meeting"] floating enable, resize set 1100 650, move position center

# File management and system resources
for_window [class="dolphin"] floating enable, resize set 1000 600
for_window [class="kith"] floating enable, border none, sticky enable
for_window [class="Pavucontrol"] floating enable

# ========================================================
#  COLORS
# ========================================================

# Theme colors
set $bg           #11111b
set $fg           #CDD6F4
set $selected     #181825
set $muted        #585B70
set $muted_dark   #313244
set $lightblue    #89DCEB
set $red          #E78284

# class                   border      background    text        indicator   child_border
client.focused            $lightblue  $selected     $fg         $lightblue  $lightblue
client.focused_inactive   $muted_dark $selected     $fg         $muted_dark $muted_dark
client.unfocused          $muted_dark $bg           $muted      $muted_dark $muted_dark
client.urgent             $red        $bg           $fg         $red        $red
client.placeholder        $muted_dark $bg           $fg         $muted_dark $muted_dark
client.background         $bg
