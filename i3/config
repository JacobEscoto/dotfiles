# ========================================================
#  SETTINGS
# ========================================================
set $mod Mod4
set $terminal kitty
set $file_manager dolphin

# Font for window titles
font pango:Fira Code 10

# Disable fullscreen for the first window
for_window [workspace=".*"] fullscreen disable

# Window borders
for_window [class="^.*"] border pixel 0

# Gaps
gaps inner 5
gaps outer 5
gaps top 40
smart_gaps off
smart_borders on

# ========================================================
#  STARTUP
# ========================================================

# Battery monitor
exec_always --no-startup-id ~/.config/i3/scripts/battery.sh

# Enable touchpad tapping
exec --no-startup-id xinput set-prop "SynPS/2 Synaptics TouchPad" "libinput Tapping Enabled" 1

# Run commands for desktop personalization (Workspaces, polybar, wallpaper and picom).
exec --no-startup-id i3-msg 'workspace 1:web; workspace 2:code; workspace 3:files; workspace 1:web'
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id feh --bg-scale ~/Pictures/forest-wallpaper.jpg
exec_always --no-startup-id picom -b
exec_always --no-startup-id dunst

# Start flameshot in the background
exec --no-startup-id flameshot

# Toggle keyboard language
exec --no-startup-id bash -c "sleep 2 && setxkbmap -layout us,latam -option grp:alt_shift_toggle"

# ========================================================
#  KEYBINDINGS
# ========================================================

# Volume
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-source-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Multimedia playback controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Brightness
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# App launcher
bindsym $mod+space exec --no-startup-id ~/.config/rofi/scripts/launcher.sh

# File manager
bindsym $mod+e exec --no-startup-id $file_manager
bindsym $mod+Shift+e exec --no-startup-id kitty -- spf

# Task manager
bindsym Control+Shift+Escape exec --no-startup-id kitty -- btop

# Terminal
bindsym $mod+Return exec $terminal
bindsym $mod+Shift+t exec $terminal

# Kill window
bindsym $mod+Shift+q kill

# Floating modifier
floating_modifier $mod

# Change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Change focus (arrow keys as alternative)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Move windows (arrow keys as alternative)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split horizontal and vertical
bindsym $mod+minus split h
bindsym $mod+backslash split v

# Fullscreen mode
bindsym $mod+f fullscreen toggle

# Reload configuration
bindsym $mod+Shift+c reload

# Restart i3
bindsym $mod+Shift+r restart

# Lock screen
bindsym $mod+Escape exec --no-startup-id ~/.config/i3/scripts/lock.sh

# Take screenshot with flameshot
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym Shift+Print exec --no-startup-id flameshot gui -d 3000

# ========================================================
#  WORKSPACES
# ========================================================
set $ws1 "1:web"
set $ws2 "2:terminal"
set $ws3 "3:docs"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

# Move window to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9; workspace number $ws9

# Cycle workspaces
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

#
bindsym $mod+r mode "resize"

mode "resize" {
  bindsym h resize shrink width 10 px or 10 ppt
  bindsym j resize grow height 10 px or 10 ppt
  bindsym k resize shrink height 10 px or 10 ppt
  bindsym l resize grow width 10 px or 10 ppt
  bindsym Return mode "default"
  bindsym Escape mode "default"
}

# Zoom tools opens in floating mode. The main window of Zoom will remain fixed
for_window [class="^zoom$"] floating enable
for_window [class="^zoom$" title="Zoom Meeting"] floating disable
