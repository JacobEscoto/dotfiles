# ========================================================
#  SETTINGS
# ========================================================
set $mod Mod4
set $terminal kitty
set $file_manager dolphin
set $browser firefox

# Font for window titles
font pango:Rubik 8

default_border none
default_floating_border none
hide_edge_borders both

workspace_layout default
workspace_auto_back_and_forth yes
focus_follows_mouse no
mouse_warping output
popup_during_fullscreen smart

default_orientation horizontal

# Gaps
gaps inner 6
gaps outer 4
gaps top 30
smart_gaps off

# ========================================================
#  STARTUP
# ========================================================

# Enable touchpad tapping dynamically
exec --no-startup-id ~/.config/i3/scripts/touchpad-setup.sh

# Run commands for desktop personalization (Workspaces, polybar, wallpaper and picom).
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id ~/.config/i3/scripts/set-wallpaper.sh
exec_always --no-startup-id pkill -x picom; picom -b
exec_always --no-startup-id pkill -x dunst; dunst

# Start flameshot in the background
exec --no-startup-id flameshot

# Toggle keyboard language
exec --no-startup-id bash -c "sleep 2 && setxkbmap -layout 'us,latam' -option 'grp:alt_shift_toggle'"

# Battery monitoring
exec --no-startup-id bash -c '~/.config/i3/scripts/battery-watch.sh'

# ========================================================
#  KEYBINDINGS
# ========================================================

# Volume
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/osd-volume.sh -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/osd-volume.sh -d 5
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/scripts/osd-volume.sh -t

# Multimedia playback controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Brightness
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/scripts/osd-brightness.sh set 10%+
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/osd-brightness.sh set 10%-

# Apps
bindsym $mod+Return exec $terminal
bindsym $mod+b exec $browser
bindsym $mod+e exec $file_manager
bindsym $mod+Shift+o exec --no-startup-id ~/.local/bin/opencode-desktop.AppImage

# App launcher
bindsym $mod+d exec --no-startup-id ~/.config/rofi/scripts/launcher.sh

bindsym $mod+period exec rofi -show emoji -modi emoji -theme ~/.config/rofi/emoji.rasi -emoji-format "{emoji}" -p ""

# Task manager
bindsym Control+Shift+Escape exec --no-startup-id kitty -- btop

# Kill window
bindsym $mod+w kill
bindsym $mod+Shift+q kill

# Floating modifier
floating_modifier $mod

# Floating toggle
bindsym $mod+Shift+space floating toggle

# Layouts
bindsym $mod+t layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+d layout toggle split

# Change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split horizontal and vertical
bindsym $mod+x split h
bindsym $mod+v split v

# Fullscreen mode
bindsym $mod+f fullscreen toggle

# Reload configuration
bindsym $mod+Shift+c reload

# Restart i3
bindsym $mod+Shift+r restart

# Lock screen
bindsym $mod+Escape exec --no-startup-id ~/.config/i3/scripts/lock.sh

# Take screenshot with flameshot
bindsym Print exec --no-startup-id flameshot gui
bindsym $mod+Shift+Print exec --no-startup-id flameshot gui -d 3000

# ========================================================
#  WORKSPACES
# ========================================================
set $ws1 "1:web"
set $ws2 "2:terminal"
set $ws3 "3:docs"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

# Move window to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9; workspace number $ws9

# Cycle workspaces
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

# Resize mode
bindsym $mod+r mode "resize"

mode "resize" {
  # Vim-style navigation
  bindsym h resize shrink width 5 px or 5 ppt
  bindsym j resize grow height 5 px or 5 ppt
  bindsym k resize shrink height 5 px or 5 ppt
  bindsym l resize grow width 5 px or 5 ppt

  # Exit resize mode
  bindsym Return mode "default"
  bindsym Escape mode "default"
}

# ========================================================
#  Floating mode
# ========================================================
for_window [class="dolphin"] floating enable, border none
for_window [class="Polybar"] floating enable, border none
