# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go is formatted by gofmt, which enforces tabs.
[*.go]
indent_style = tab

# INI-style desktop configs in this repo are indented with 4 spaces.
[dunst/dunstrc]
indent_size = 4

[picom/picom.conf]
indent_size = 4

[fastfetch/*.jsonc]
indent_size = 4

# Polybar format strings use trailing spaces as intentional padding after
# icon glyphs and labels. Trimming them breaks rendering.
[polybar/**]
trim_trailing_whitespace = false

# Micro writes binary buffer state here; never touch it.
[micro/buffers/**]
insert_final_newline = unset
trim_trailing_whitespace = unset